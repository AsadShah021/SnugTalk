// SnugTalk — database schema
//
// Scoped to what the frontend actually does today: accounts, the meeting
// request form, and chat. Tables for the parked features (services, plans,
// subscriptions, notes, ideas, reviews, availability) are listed at the bottom
// as comments — add them when those features come back, not before.
//
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 no longer accepts `url` here — the connection string lives in
// prisma.config.ts, and the runtime client gets it via a driver adapter.
datasource db {
  provider = "mysql"
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Users
 */
/**
 * --------------------------------------------------------------------------
 */

enum Role {
  MEMBER
  LISTENER
  ADMIN
}

model User {
  id           String  @id @default(cuid())
  name         String  @db.VarChar(120)
  // 191 chars, not 255: a utf8mb4 index key is 4 bytes per char, and older
  // MySQL/InnoDB caps index keys at 767 bytes. 191 is always safe.
  email        String  @unique @db.VarChar(191)
  passwordHash String  @db.VarChar(255)
  role         Role    @default(MEMBER)
  /// 0 until they enter the emailed code, 1 once they have. Google sign-ups
  /// arrive as 1 — Google has already proven the address, so asking again is
  /// friction with no security gain.
  ///
  /// MySQL stores this as TINYINT(1), so it reads as a plain 0/1 in any
  /// database client.
  isVerified   Boolean @default(false)

  /// Set by an admin to stop somebody using the service. Blocked accounts keep
  /// all their data — this is a door being closed, not a deletion — but they
  /// cannot sign in, and any session they already hold stops working on the
  /// next request.
  isBlocked Boolean   @default(false)
  /// When the block was applied, so support can tell a recent action from an
  /// old one when somebody writes in to appeal.
  blockedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listenerProfile       ListenerProfile?
  requests              MeetingRequest[]    @relation("Requester")
  assignedRequests      MeetingRequest[]    @relation("AssignedListener")
  conversations         Conversation[]      @relation("Member")
  assignedConversations Conversation[]      @relation("ConversationListener")
  messages              Message[]
  sentConnections       ConnectionRequest[] @relation("MemberConnections")
  receivedConnections   ConnectionRequest[] @relation("ListenerConnections")
  emailOtps             EmailOtp[]

  @@map("users")
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/**
 * A one-time code sent to an email address.
 * Only a hash of the code is stored. A six-digit code is worth very little on
 * its own, but a database dump should never hand somebody a set of live codes
 * they can type straight into the login form.
 */
model EmailOtp {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the code. Not bcrypt: the code is high-entropy-per-guess only
  /// because of the attempt cap, and verification happens on a hot path.
  codeHash String     @db.Char(64)
  purpose  OtpPurpose

  /// Counted server-side. Six digits is a million guesses — without a cap it
  /// falls to a script in minutes.
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  /// Look-ups are always "the newest live code of this purpose for this user".
  @@index([userId, purpose, consumedAt])
  @@map("email_otps")
}

/// One-to-one extension of User for role = LISTENER.
model ListenerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug        String   @unique @db.VarChar(120)
  headline    String   @db.VarChar(200)
  bio         String   @db.Text
  avatarUrl   String?  @db.VarChar(500)
  location    String?  @db.VarChar(120)
  timezone    String   @db.VarChar(60)
  // JSON is fine while the public directory is parked. If you bring back
  // filtering by specialty, promote these to their own tables so they can be
  // indexed — you cannot efficiently query inside a JSON column.
  languages   Json
  specialties Json
  isOnShift   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("listener_profiles")
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Meeting requests
 */
/**
 * --------------------------------------------------------------------------
 */

enum RequestStatus {
  NEW
  REVIEWING
  SCHEDULED
  DECLINED
}

/// Submitted by the /book form. A person reads it and agrees a time by email.
model MeetingRequest {
  id        String @id @default(cuid())
  /// Human-quotable id shown to the member, e.g. "SNG-8241".
  reference String @unique @db.VarChar(20)

  // Kept even if the account is later deleted, so the team's queue history
  // stays intact — hence SetNull rather than Cascade.
  userId String?
  user   User?   @relation("Requester", fields: [userId], references: [id], onDelete: SetNull)

  /// Copied at submit time so the request still reads correctly if the user
  /// later changes their name or email.
  name  String @db.VarChar(120)
  email String @db.VarChar(191)
  topic String @db.Text

  status             RequestStatus @default(NEW)
  assignedListenerId String?
  assignedListener   User?         @relation("AssignedListener", fields: [assignedListenerId], references: [id], onDelete: SetNull)
  scheduledFor       DateTime?
  meetUrl            String?       @db.VarChar(500)
  internalNote       String?       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The queue is always "open requests, oldest first".
  @@index([status, createdAt])
  @@index([userId])
  @@map("meeting_requests")
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Connection requests
 */
/**
 * --------------------------------------------------------------------------
 */

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/**
 * A member asking a specific listener to be theirs.
 * Accepting assigns that listener to the member's conversation, so replies come
 * from a known person rather than whoever is free. Declining is deliberately a
 * first-class outcome: a listener who is at capacity, or who isn't the right
 * fit, should be able to say so without it being a failure.
 */
model ConnectionRequest {
  id String @id @default(cuid())

  memberId String
  member   User   @relation("MemberConnections", fields: [memberId], references: [id], onDelete: Cascade)

  listenerId String
  listener   User   @relation("ListenerConnections", fields: [listenerId], references: [id], onDelete: Cascade)

  status      ConnectionStatus @default(PENDING)
  /// Optional note from the member — why this listener, what they'd like to talk about.
  message     String?          @db.Text
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One request per pair: asking again updates the existing row.
  @@unique([memberId, listenerId])
  @@index([listenerId, status])
  @@index([memberId, status])
  @@map("connection_requests")
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Chat
 */
/**
 * --------------------------------------------------------------------------
 */

enum ConversationStatus {
  WAITING
  ACTIVE
  CLOSED
}

model Conversation {
  id       String @id @default(cuid())
  memberId String
  member   User   @relation("Member", fields: [memberId], references: [id], onDelete: Cascade)

  assignedListenerId String?
  assignedListener   User?   @relation("ConversationListener", fields: [assignedListenerId], references: [id], onDelete: SetNull)

  status        ConversationStatus @default(WAITING)
  /// Denormalised so the inbox can sort without touching the messages table.
  lastMessageAt DateTime           @default(now())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  messages Message[]

  @@index([status, lastMessageAt])
  @@index([memberId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  body      String    @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Parked — add later
 */
/**
